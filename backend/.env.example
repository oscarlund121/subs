# Copy this file to .env and fill in the values. .env is gitignored.

# Port the NestJS API listens on
PORT=3000

# Clerk secret key (auth) — leave empty while auth is disabled
CLERK_SECRET_KEY=

# Gmail OAuth (for the email watcher).
# Generate the refresh token with: scripts/get-gmail-token.mjs
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
