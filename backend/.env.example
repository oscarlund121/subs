# Copy to `.env` and fill in. `.env` is gitignored.

# Port the API listens on (default 3000).
PORT=3000

# --- Gmail (subscription detection) -----------------------------------------
# Create an OAuth client (type: Desktop app) in Google Cloud Console, enable the
# Gmail API, then run:
#   GMAIL_CLIENT_ID=... GMAIL_CLIENT_SECRET=... node scripts/get-gmail-token.mjs
# and paste the refresh token it prints below.
# Without these three the email watcher stays idle and the rest of the API works.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Auth -------------------------------------------------------------------
# Leave empty during local development: ClerkAuthGuard passes requests through
# when it is unset. Note the guard is not applied globally yet — see the guard's
# doc comment.
CLERK_SECRET_KEY=
