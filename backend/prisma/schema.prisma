generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Subscription {
  id          String      @id @default(cuid())
  name        String
  /// Normalised `name` (lowercased, punctuation stripped) used to recognise a
  /// service we already track, so confirming two receipts from the same
  /// merchant updates one subscription instead of creating duplicates.
  nameKey     String      @default("")
  category    String
  price       Float
  currency    String      @default("DKK")
  cycle       String      @default("monthly") // weekly | monthly | quarterly | yearly
  nextRenewal DateTime
  trialEndsAt DateTime?
  /// When we last surfaced a "trial ending soon" reminder — a trial nags at
  /// most once. Reset to null whenever the trial end date changes.
  trialRemindedAt DateTime?
  status      String      @default("active") // active | trial | cancelled
  source      String      @default("Website")
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  detections  Detection[]

  @@index([nameKey])
}

model Detection {
  id             String        @id @default(cuid())
  emailId        String        @unique // Gmail message id, for dedup
  from           String?
  subject        String?
  snippet        String?
  service        String?
  category       String?
  price          Float?
  currency       String?
  cycle          String?
  /// Next charge date, as stated in the email or derived from it.
  renewalAt      DateTime?
  trialEndsAt    DateTime?
  confidence     Float?
  /// Why the parser decided what it did — kept for tuning the rules.
  parseReasons   String?
  status         String        @default("pending") // pending | confirmed | ignored
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  subscriptionId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, createdAt])
}

model CancellationGuide {
  id            String    @id @default(cuid())
  nameKey       String    @unique
  serviceName   String
  cancelUrl     String
  /// JSON array of short "where to click" steps.
  steps         String
  discoveredAt  DateTime  @default(now())
  lastVerifiedAt DateTime?
  updatedAt     DateTime  @updatedAt
}
